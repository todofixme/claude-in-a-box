#!/usr/bin/env bash
#
# claude-box - run Claude Code in YOLO mode inside a Box.
#
# Started in a project directory on the Host, it mounts that Workspace into a
# Box at the same absolute path and hands it to Claude with permission checks
# switched off. Flags it does not recognise are passed on to Claude.
#
# The Box runs privileged and brings up its own dockerd, so Claude can run
# tests that need Test Containers (ADR-0001). That daemon's data lives in a
# volume of its own per Workspace, which is why only one Box per Workspace may
# run: two daemons on one data directory corrupt it.
#
# A backend build downloads its dependencies into the Box, where one Box Cache
# per Workspace keeps them for the next Box. Nothing of the Host's own caches
# is mounted (ADR-0004).

set -euo pipefail

readonly DEFAULT_IMAGE="ghcr.io/todofixme/claude-in-a-box:latest"
# Claude's login, settings and session history live in the Box's home
# directory. One volume shared by every Box keeps them across restarts.
readonly DEFAULT_HOME_VOLUME="claude-home"
readonly BOX_HOME="/home/claude"
readonly BOX_DOCKER_DATA="/var/lib/docker"
# Maven and Gradle put everything they download under these two, dependencies
# and wrapper distributions alike, so a Box Cache mounted on each is the whole
# mechanism: the Image configures neither tool.
readonly BOX_CACHE_MAVEN="$BOX_HOME/.m2"
readonly BOX_CACHE_GRADLE="$BOX_HOME/.gradle"
# Same mechanism for the frontend tools: npm's cache, pnpm's store and the
# Playwright browser cache, each where the tool already looks by default.
readonly BOX_CACHE_NPM="$BOX_HOME/.npm"
readonly BOX_CACHE_PNPM="$BOX_HOME/.local/share/pnpm"
readonly BOX_CACHE_PLAYWRIGHT="$BOX_HOME/.cache/ms-playwright"

usage() {
  cat <<USAGE
Usage: claude-box [options] [claude arguments...]

Runs Claude Code in YOLO mode inside a Box, on the current directory.

Options:
  --shell              Open a bash login shell in the Box instead of Claude
  --no-pull            Use the Image already on the Host instead of pulling
  --image REF          Image to start the Box from
                       (default: \$CLAUDE_BOX_IMAGE, else $DEFAULT_IMAGE)
  --dry-run            Print the docker command instead of running it
  -h, --help           Show this help
  --                   Pass everything that follows to Claude

Any other argument is passed to Claude, so \`claude-box --resume\` resumes this
Workspace's previous session.

Environment:
  CLAUDE_BOX_IMAGE          Default Image reference
  CLAUDE_BOX_HOME_VOLUME    Volume holding Claude's login and state
                            (default: $DEFAULT_HOME_VOLUME)
  CLAUDE_BOX_GH_TOKEN       Token \`gh\` uses in the Box; a read-only
                            fine-grained GitHub token is recommended
  CLAUDE_BOX_GITLAB_TOKEN   Token \`glab\` uses in the Box; a read-only
                            GitLab token is recommended
USAGE
}

die() {
  printf 'claude-box: %s\n' "$1" >&2
  exit 1
}

# Appends `-e NAME=value` to docker_argv for each name, but only when value is
# non-empty: an unset Host variable must leave the Box without the variable
# at all, not with it set to an empty string.
pass_env_if_set() {
  local value="$1"
  shift
  [ -n "$value" ] || return 0
  local name
  for name in "$@"; do
    docker_argv+=(-e "$name=$value")
  done
}

image="${CLAUDE_BOX_IMAGE:-$DEFAULT_IMAGE}"
pull=1
shell=0
dry_run=0
claude_argv=()

while [ $# -gt 0 ]; do
  case "$1" in
    --shell)
      shell=1
      shift
      ;;
    --no-pull)
      pull=0
      shift
      ;;
    --image)
      [ $# -ge 2 ] || die "--image needs an Image reference"
      image="$2"
      shift 2
      ;;
    --image=*)
      image="${1#--image=}"
      [ -n "$image" ] || die "--image needs an Image reference"
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      claude_argv+=("$@")
      break
      ;;
    *)
      claude_argv+=("$1")
      shift
      ;;
  esac
done

workspace="$(pwd -P)"
home_volume="${CLAUDE_BOX_HOME_VOLUME:-$DEFAULT_HOME_VOLUME}"

# Every name has to be derivable from the Workspace path alone, so that each
# start in a Workspace finds the same Docker data and Box Caches again and
# recognises a Box that Workspace already has running. The basename only makes
# them readable in `docker ps`; the digest is what keeps two Workspaces apart.
digest_of() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256
  else
    printf '%s' "$1" | sha256sum
  fi | cut -c1-12
}

slug="$(basename "$workspace")"
# Docker names take letters, digits and _.- only.
slug="${slug//[^a-zA-Z0-9_.-]/-}"
workspace_id="$slug-$(digest_of "$workspace")"
box_name="claude-box-$workspace_id"
docker_volume="claude-docker-$workspace_id"
maven_volume="claude-maven-$workspace_id"
gradle_volume="claude-gradle-$workspace_id"
npm_volume="claude-npm-$workspace_id"
pnpm_volume="claude-pnpm-$workspace_id"
playwright_volume="claude-playwright-$workspace_id"

docker_argv=(
  docker run --rm -i
  --name "$box_name"
  # Needed by the dockerd the Box starts for itself. The Host's Docker socket
  # is deliberately not mounted: through it Claude could reach the Host.
  --privileged
  -v "$workspace:$workspace"
  -v "$home_volume:$BOX_HOME"
  -v "$docker_volume:$BOX_DOCKER_DATA"
  # Nested inside the home volume above; docker mounts the deeper paths last,
  # so each Box Cache wins over what the home volume holds there.
  -v "$maven_volume:$BOX_CACHE_MAVEN"
  -v "$gradle_volume:$BOX_CACHE_GRADLE"
  -v "$npm_volume:$BOX_CACHE_NPM"
  -v "$pnpm_volume:$BOX_CACHE_PNPM"
  -v "$playwright_volume:$BOX_CACHE_PLAYWRIGHT"
  -w "$workspace"
)

# Claude commits locally under the developer's identity, read here from the
# Host's own `git config` so a Workspace-local config wins the way it always
# does for `git` itself; the Box never gets credentials to push with, so
# `git push` there fails for lack of them. `git config` exits non-zero on an
# unset key, which `|| true` turns into an empty string instead of failing
# the whole script.
git_author_name="$(git config user.name || true)"
git_author_email="$(git config user.email || true)"
pass_env_if_set "$git_author_name" GIT_AUTHOR_NAME GIT_COMMITTER_NAME
pass_env_if_set "$git_author_email" GIT_AUTHOR_EMAIL GIT_COMMITTER_EMAIL

# gh and glab both read these variables directly. Unset on the Host, nothing
# is passed in and neither variable exists in the Box at all, rather than
# existing empty; a read-only, fine-grained token is what the README
# recommends for each.
pass_env_if_set "${CLAUDE_BOX_GH_TOKEN:-}" GH_TOKEN
pass_env_if_set "${CLAUDE_BOX_GITLAB_TOKEN:-}" GITLAB_TOKEN

# Claude needs a terminal, but asking docker for one when there is none to
# forward makes it refuse to start, so piping into `--shell` stays possible.
if [ -t 0 ]; then
  docker_argv+=(-t)
fi

if [ "$pull" -eq 1 ]; then
  docker_argv+=(--pull always)
else
  # `never` rather than docker's default `missing`, so a typo in --image fails
  # on the Host with a clear message instead of reaching for a registry.
  docker_argv+=(--pull never)
fi

docker_argv+=("$image")

if [ "$shell" -eq 1 ]; then
  [ ${#claude_argv[@]} -eq 0 ] || die "--shell takes no Claude arguments"
  docker_argv+=(bash -l)
else
  docker_argv+=(claude --dangerously-skip-permissions)
  [ ${#claude_argv[@]} -eq 0 ] || docker_argv+=("${claude_argv[@]}")
fi

if [ "$dry_run" -eq 1 ]; then
  printf '%q ' "${docker_argv[@]}"
  printf '\n'
  exit 0
fi

command -v docker >/dev/null 2>&1 || die "docker not found on PATH"

# docker refuses a Box of the same name on its own, but its message says
# nothing about Workspaces. If it cannot answer at all, leave the complaining
# to the `docker run` below.
case "$(docker ps --all --filter "name=^${box_name}\$" --format '{{.State}}' 2>/dev/null)" in
  "") ;;
  running)
    die "a Box is already running on $workspace; leave that one first"
    ;;
  *)
    # A Box is thrown away when it ends, so one still here has not ended
    # cleanly. Its Docker data is intact, but only docker can free the name.
    die "a Box on $workspace did not clean up after itself; remove it with: docker rm $box_name"
    ;;
esac

exec "${docker_argv[@]}"
